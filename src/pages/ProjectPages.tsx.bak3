import { useEffect, useRef, useState, ReactNode } from 'react'
import { Link, NavLink, useNavigate, useParams } from 'react-router-dom'
import { supabase, callAI } from '../lib/supabase'
import { buildTemplate } from '../lib/templates'
import { clean } from '../lib/clean'
import { exportPdf, exportDocx } from '../lib/export'
type Row = Record<string, any>
const sleep = (ms: number) => new Promise(r => setTimeout(r, ms))

function useProject() {
  const { id } = useParams(); const [p, setP] = useState<Row | null>(null)
  const reload = () => supabase.from('projects').select('*').eq('id', id).single().then(({ data }) => setP(data))
  useEffect(() => { reload() }, [id]); return { id: id!, p, reload }
}
function Shell({ id, p, children }: { id: string; p: Row | null; children: ReactNode }) {
  const links = [['', 'Overview'], ['interview', 'Interview'], ['generate', 'Generate'], ['editor', 'Editor'], ['sources', 'Sources'], ['settings', 'Settings']]
  return (
    <div className="mx-auto flex max-w-6xl flex-col gap-6 p-5 md:flex-row">
      <nav className="shrink-0 md:w-48"><Link to="/dashboard" className="text-sm underline">← Dashboard</Link><p className="font-display my-3 font-semibold">{p?.topic}</p>
        <div className="flex flex-wrap gap-1 md:flex-col">{links.map(([t, n]) => <NavLink key={t} end to={`/projects/${id}/${t}`} className={({ isActive }) => `rounded-lg px-3 py-2 text-sm ${isActive ? 'bg-brand text-white' : 'hover:bg-ink/5'}`}>{n}</NavLink>)}</div></nav>
      <main className="min-w-0 flex-1">{children}</main>
    </div>)
}

export function Overview() {
  const { id, p } = useProject(); const [mem, setMem] = useState<Row>({})
  useEffect(() => { supabase.from('project_memory').select('data').eq('project_id', id).maybeSingle().then(({ data }) => setMem(data?.data ?? {})) }, [id])
  const arr = (v: any) => (Array.isArray(v) ? v : v ? [v] : [])
  const rows: [string, any][] = [['Course', p?.course_name], ['Level', p?.level], ['Institution', p?.institution], ['Topic', p?.topic], ['Project type', p?.project_type], ['Problem', mem.problem], ['Aim', mem.aim], ['Target users', mem.targetUsers], ['Proposed solution', mem.proposedSolution], ['Methodology', mem.methodology], ['Main features', arr(mem.features)], ['Objectives', arr(mem.objectives)], ['Assumptions', arr(mem.assumptions)]]
  return <Shell id={id} p={p}><h1 className="font-display text-2xl font-semibold">Project memory</h1><p className="mb-4 text-sm text-ink/60">This is what the AI uses to write your project. Status: <b>{p?.status}</b></p>
    <dl className="space-y-3 rounded-xl border border-ink/10 bg-white p-5">{rows.filter(r => r[1] && (!Array.isArray(r[1]) || r[1].length)).map(([k, v]) => <div key={k}><dt className="text-sm font-semibold">{k}</dt><dd className="text-ink/80">{Array.isArray(v) ? <ul className="list-disc pl-5">{v.map((x: string) => <li key={x}>{x}</li>)}</ul> : v}</dd></div>)}</dl></Shell>
}

export function Interview() {
  const { id, p } = useProject(); const nav = useNavigate(); const [qs, setQs] = useState<Row[]>([]); const [a, setA] = useState(''); const [busy, setBusy] = useState(false); const [err, setErr] = useState('')
  const load = async () => { const { data } = await supabase.from('project_questions').select('*').eq('project_id', id).order('position'); setQs(data ?? []); return data ?? [] }
  async function next() { setBusy(true); setErr(''); const r = await callAI({ action: 'interview', projectId: id }); if (r.error) setErr(r.error); else if (r.done) return nav(`/projects/${id}/generate`); await load(); setBusy(false) }
  useEffect(() => { load().then(d => { if (!d.length) next() }) }, [id])
  const cur = qs.find(q => !q.answer)
  async function submit() { await supabase.from('project_questions').update({ answer: a }).eq('id', cur!.id); setA(''); await load(); await next() }
  return <Shell id={id} p={p}><h1 className="font-display text-2xl font-semibold">A few questions about your project</h1>
    <div className="mt-4 space-y-4">{qs.filter(q => q.answer).map(q => <div key={q.id}><p className="font-medium">{q.question}</p><p className="text-ink/70">{q.answer}</p></div>)}
      {cur && <div><p className="font-medium">{cur.question}</p><textarea className="input mt-2" rows={3} value={a} onChange={e => setA(e.target.value)} /><button className="btn-primary mt-2" disabled={!a.trim() || busy} onClick={submit}>{busy ? 'Thinking…' : 'Answer'}</button></div>}
      {busy && !cur && <p>Preparing your next question…</p>}{err && <p role="alert" className="text-red-700">{err} <button className="underline" onClick={next}>Try again</button></p>}</div></Shell>
}

export function Generate() {
  const { id, p, reload } = useProject(); const [pages, setPages] = useState(40); const [secs, setSecs] = useState<Row[]>([]); const [chs, setChs] = useState<Row[]>([]); const [act, setAct] = useState(''); const [run, setRun] = useState(false); const stop = useRef(false)
  const load = async () => { const [a, b] = await Promise.all([supabase.from('project_chapters').select('*').eq('project_id', id).order('position'), supabase.from('project_sections').select('*').eq('project_id', id).order('position')]); setChs(a.data ?? []); setSecs(b.data ?? []); return b.data ?? [] }
  useEffect(() => { load() }, [id])
  async function start() {
    setRun(true); stop.current = false; await supabase.from('projects').update({ target_pages: pages, status: 'generating' }).eq('id', id)
    const have = await supabase.from('project_sources').select('id', { count: 'exact', head: true }).eq('project_id', id)
    if (!have.count) { setAct('Finding real references with Google Search…'); await callAI({ action: 'find_references', projectId: id }) }
    if (!chs.length) { let pos = 0; setAct('Preparing structure…')
      for (const [i, c] of buildTemplate(p?.project_type ?? '').entries()) { const { data: ch } = await supabase.from('project_chapters').insert({ project_id: id, position: i + 1, title: c.title }).select().single()
        for (const h of c.sections) { const { data: s } = await supabase.from('project_sections').insert({ project_id: id, chapter_id: ch!.id, position: ++pos, heading: h }).select().single(); await supabase.from('project_generation_jobs').insert({ project_id: id, chapter_id: ch!.id, section_id: s!.id }) } } }
    const gaveUp = new Set<string>(); const tries: Record<string, number> = {}
    for (;;) {
      const all = await load(); const s = all.find(x => x.status !== 'completed' && !gaveUp.has(x.id)); if (!s || stop.current) break
      const ch = (await supabase.from('project_chapters').select('title').eq('id', s.chapter_id).single()).data
      setAct(`Writing ${ch?.title} — ${s.heading}`); tries[s.id] = (tries[s.id] ?? 0) + 1
      await supabase.from('project_generation_jobs').update({ status: 'running', attempts: tries[s.id], started_at: new Date().toISOString() }).eq('section_id', s.id)
      const r = await callAI({ action: 'generate_section', projectId: id, sectionId: s.id })
      if (r.ok) await supabase.from('project_generation_jobs').update({ status: 'completed', completed_at: new Date().toISOString() }).eq('section_id', s.id)
      else { await supabase.from('project_generation_jobs').update({ status: 'failed', error: r.error }).eq('section_id', s.id); if (tries[s.id] >= 3) gaveUp.add(s.id); setAct(r.error ?? 'Retrying…'); await sleep(/Rate/.test(r.error ?? '') ? 30000 : 3000) }
      await sleep(1500)
    }
    const fin = await load(); await supabase.from('projects').update({ status: fin.every(x => x.status === 'completed') ? 'review' : 'failed' }).eq('id', id); setRun(false); setAct(''); reload()
  }
  const done = secs.filter(s => s.status === 'completed').length; const pct = secs.length ? Math.round((done / secs.length) * 100) : 0
  const icon = (st: string) => (st === 'completed' ? '✓' : st === 'generating' ? '…' : st === 'failed' ? '!' : '○')
  return <Shell id={id} p={p}><h1 className="font-display text-2xl font-semibold">Generate your project</h1>
    {!secs.length && <div className="mt-4"><p className="font-medium">How detailed should your project be?</p><p className="mb-3 text-sm text-ink/60">Page count is approximate. Real length depends on font, spacing, tables, figures and references.</p>
      <div className="flex flex-wrap gap-2">{[20, 40, 60, 80, 100].map(n => <button key={n} onClick={() => setPages(n)} className={`rounded-lg border px-4 py-2 ${pages === n ? 'border-brand bg-brand/10' : 'border-ink/20 bg-white'}`}>{n}{n === 100 ? '+' : ''} pages</button>)}</div></div>}
    {secs.length > 0 && <div className="mt-4"><div className="h-3 overflow-hidden rounded-full bg-ink/10"><div className="h-full bg-brand transition-all" style={{ width: `${pct}%` }} /></div><p className="mt-1 text-sm">{pct}% — {act || (done === secs.length ? 'All sections written' : 'Paused')}</p>
      <ul className="mt-4 space-y-3">{chs.map(c => { const s = secs.filter(x => x.chapter_id === c.id); return <li key={c.id}><b>{icon(s.every(x => x.status === 'completed') ? 'completed' : s.some(x => x.status === 'generating') ? 'generating' : s.some(x => x.status === 'failed') ? 'failed' : 'pending')} Chapter {c.position}: {c.title}</b><span className="ml-2 text-sm text-ink/60">{s.filter(x => x.status === 'completed').length}/{s.length} sections</span></li> })}</ul></div>}
    <div className="mt-6 flex gap-3"><button className="btn-primary" disabled={run} onClick={start}>{secs.length ? (run ? 'Generating…' : 'Continue generation') : 'Start generation'}</button>{run && <button className="btn-ghost" onClick={() => (stop.current = true)}>Pause</button>}{done > 0 && !run && <Link className="btn-ghost" to={`/projects/${id}/editor`}>Open editor</Link>}</div>
    <p className="mt-3 text-sm text-ink/60">Keep this tab open while generating. Each section is saved as soon as it is written; failed sections are retried on their own.</p></Shell>
}

export function Editor() {
  const { id, p } = useProject(); const [chs, setChs] = useState<Row[]>([]); const [secs, setSecs] = useState<Row[]>([]); const [sel, setSel] = useState<string>(''); const [edit, setEdit] = useState(false); const [txt, setTxt] = useState(''); const [email, setEmail] = useState(''); const [busy, setBusy] = useState(false); const [msg, setMsg] = useState('')
  const load = async () => { const [a, b] = await Promise.all([supabase.from('project_chapters').select('*').eq('project_id', id).order('position'), supabase.from('project_sections').select('*').eq('project_id', id).order('position')]); setChs(a.data ?? []); setSecs(b.data ?? []); if (!sel && b.data?.length) setSel(b.data[0].id) }
  useEffect(() => { load(); supabase.auth.getUser().then(({ data }) => setEmail(data.user?.email ?? '')) }, [id])
  const s = secs.find(x => x.id === sel); useEffect(() => { setTxt(s?.content ?? ''); setEdit(false) }, [sel, s?.content])
  async function save() { await supabase.from('project_sections').update({ content: txt, user_edited: true, updated_at: new Date().toISOString() }).eq('id', sel); setMsg('Saved'); await load(); setEdit(false) }
  async function regen() { if (!s) return; if (s.user_edited && !confirm('You edited this section. Regenerating will replace your changes. Continue?')) return; setBusy(true); const r = await callAI({ action: 'generate_section', projectId: id, sectionId: sel }); if (r.ok) await supabase.from('project_sections').update({ user_edited: false }).eq('id', sel); setMsg(r.ok ? 'Regenerated' : r.error); await load(); setBusy(false) }
  const block = (e: { preventDefault: () => void }) => e.preventDefault()
  return <Shell id={id} p={p}><div className="flex flex-col gap-4 lg:flex-row"><aside className="lg:w-56">{chs.map(c => <div key={c.id} className="mb-3"><p className="text-sm font-semibold">Chapter {c.position}</p>{secs.filter(x => x.chapter_id === c.id).map(x => <button key={x.id} onClick={() => setSel(x.id)} className={`block w-full rounded px-2 py-1 text-left text-sm ${sel === x.id ? 'bg-brand/15' : 'hover:bg-ink/5'}`}>{x.heading} {x.status !== 'completed' && <i className="text-xs">({x.status})</i>}</button>)}</div>)}</aside>
    <section className="min-w-0 flex-1">{!s ? <p>No sections yet. <Link className="underline" to={`/projects/${id}/generate`}>Generate your project</Link>.</p> : <>
      <h2 className="font-display text-xl font-semibold">{s.heading}</h2>
      <div className="my-3 flex flex-wrap gap-2">{!edit ? <button className="btn-ghost !py-1.5" onClick={() => setEdit(true)}>Edit</button> : <><button className="btn-primary !py-1.5" onClick={save}>Save changes</button><button className="btn-ghost !py-1.5" onClick={() => setEdit(false)}>Cancel</button></>}<button className="btn-ghost !py-1.5" disabled={busy} onClick={regen}>{busy ? 'Regenerating…' : 'Regenerate section'}</button>{msg && <span className="self-center text-sm">{msg}</span>}</div>
      {edit ? <textarea className="input" rows={20} value={txt} onChange={e => setTxt(e.target.value)} /> :
        <div className="relative select-none overflow-hidden rounded-xl border border-ink/10 bg-white p-6 leading-7" onContextMenu={block} onCopy={block} onCut={block} onDragStart={block}>
          <div aria-hidden className="pointer-events-none absolute inset-0 flex items-center justify-center text-3xl font-bold text-ink/5 -rotate-12">{email}</div>
          <div className="relative whitespace-pre-wrap">{clean(s.content || 'Not written yet.')}</div></div>}
      <p className="mt-2 text-xs text-ink/50">Copy protection only discourages casual copying. Screenshots and other tools can still capture this text.</p></>}</section></div></Shell>
}

export function Sources() {
  const { id, p } = useProject(); const [rows, setRows] = useState<Row[]>([]); const [c, setC] = useState(''); const [fb, setFb] = useState(''), [fbusy, setFbusy] = useState(false)
  const load = () => supabase.from('project_sources').select('*').eq('project_id', id).order('created_at').then(({ data }) => setRows(data ?? [])); useEffect(() => { load() }, [id])
  return <Shell id={id} p={p}><h1 className="font-display text-2xl font-semibold">Sources</h1><p className="mb-4 text-sm text-ink/60">Add only real sources. The AI never invents references. Mark a source “verified” once you have checked it.</p>
    <div className="mb-4"><button className="btn-gold" disabled={fbusy} onClick={async () => { setFbusy(true); setFb(''); const r = await callAI({ action: 'find_references', projectId: id }); setFbusy(false); setFb(r.error ?? `Added ${r.added} references (${r.verified} link-checked). Open each link to confirm it.`); load() }}>{fbusy ? 'Searching… this can take a minute' : 'Find 30 references with AI'}</button>{fb && <p className="mt-2 text-sm">{fb}</p>}</div>
    <div className="flex gap-2"><input className="input" placeholder="Full citation" value={c} onChange={e => setC(e.target.value)} /><button className="btn-primary" disabled={!c.trim()} onClick={async () => { await supabase.from('project_sources').insert({ project_id: id, citation: c }); setC(''); load() }}>Add</button></div>
    <ul className="mt-4 space-y-2">{rows.map(r => <li key={r.id} className="flex flex-wrap items-center gap-2 rounded-lg border border-ink/10 bg-white p-3"><span className="min-w-0 flex-1">{r.citation}</span>
      <select className="input !w-auto" value={r.provenance} onChange={async e => { await supabase.from('project_sources').update({ provenance: e.target.value }).eq('id', r.id); load() }}>{['student_provided', 'needs_verification', 'verified', 'ai_generated'].map(x => <option key={x} value={x}>{x.replace('_', ' ')}</option>)}</select>
      <button className="btn-ghost !py-1.5" onClick={async () => { await supabase.from('project_sources').delete().eq('id', r.id); load() }}>Remove</button></li>)}</ul></Shell>
}

export function Settings() {
  const { id, p, reload } = useProject(); const nav = useNavigate()
  return <Shell id={id} p={p}><h1 className="font-display text-2xl font-semibold">Settings</h1>
    <label className="mt-4 block text-sm font-medium">Writing style</label><select className="input mt-1 max-w-xs" value={p?.style ?? 'simple_english'} onChange={async e => { await supabase.from('projects').update({ style: e.target.value }).eq('id', id); reload() }}><option value="simple_english">Simple English</option><option value="standard_academic">Standard Academic</option><option value="detailed_academic">Detailed Academic</option></select>
    <h2 className="mt-8 font-semibold">Export</h2><div className="mt-2 flex gap-2"><button className="btn-primary" onClick={() => exportPdf(id)}>Download PDF</button><button className="btn-ghost" onClick={() => exportDocx(id)}>Download DOCX</button></div>
    <button className="btn-ghost mt-8 text-red-700" onClick={async () => { if (confirm('Delete this project permanently?')) { await supabase.from('projects').delete().eq('id', id); nav('/dashboard') } }}>Delete project</button></Shell>
}
